{
  "name": "dsh-chat-history-sync",
  "description": "免费。把 DeepSeek 账号的网页端和手机 App 聊天记录同步进 DSH：按月份归档、生成分类报告、可继续对话。只增不减，不碰自建会话。Windows only，token 本机 DPAPI 加密，无遥测，不调用模型。",
  "version": "0.11.58",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "locale",
    "docs",
    "cordis.patch.yml",
    "icon.png",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/run.cjs && node test/catalog.test.cjs && node test/a11y.test.cjs",
    "test:e2e": "node test/e2e-smoke.cjs",
    "check:sessions": "node test/session-health.cjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.7 || ^0.1.1-rc.2 || ^0.1.2-alpha.2 || ^0.2.0-rc.1 || ^0.2.1-alpha.3 || ^0.2.1-rc.1 || ^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "puppeteer-core": "^25.17.0"
  },
  "engines": {
    "node": ">=22.15.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "cordis",
    "plugin",
    "deepseek",
    "chat",
    "history",
    "sync",
    "archive",
    "web",
    "mobile",
    "tongbu",
    "记忆",
    "网页",
    "手机",
    "同步"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Wanghanxuyang/dsh-chat-history-sync.git"
  },
  "homepage": "https://github.com/Wanghanxuyang/dsh-chat-history-sync#readme",
  "bugs": {
    "url": "https://github.com/Wanghanxuyang/dsh-chat-history-sync/issues"
  },
  "os": [
    "win32"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web",
      "immediately": true
    }
  }
}
